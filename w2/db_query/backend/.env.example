# SQLite path for app-local persistence (connections, metadata cache, LLM settings).
# Default when unset: repo-relative path used by implementation (see quickstart).
DB_QUERY_SQLITE_PATH=

# Optional: default OpenAI-compatible API key for NL→SQL (prefer local OS secret store in production).
OPENAI_API_KEY=

# Browser/client env vars use VITE_* — see ../frontend/.env.example (e.g. VITE_API_BASE_URL).
